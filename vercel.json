{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "framework": null,
 "installCommand": "",
 "buildCommand": "node website/build.mjs",
 "outputDirectory": "website/dist",
 "cleanUrls": true,
 "trailingSlash": true,
 "redirects": [
  {
   "source": "/links/",
   "destination": "/connect/",
   "permanent": true
  },
  {
   "source": "/privacy.html",
   "destination": "/privacy-policy/",
   "permanent": true
  },
  {
   "source": "/terms.html",
   "destination": "/terms/",
   "permanent": true
  },
  {
   "source": "/index.html",
   "destination": "/",
   "permanent": true
  },
  {
   "source": "/projects/",
   "destination": "/societies/",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/mahziyar-group.vcf",
   "headers": [
    {
     "key": "Content-Type",
     "value": "text/vcard; charset=utf-8"
    },
    {
     "key": "Content-Disposition",
     "value": "attachment; filename=\"Mahziyar Group.vcf\""
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ]
}